{
  "productName": "visual-source",
  "version": "0.2.1",
  "identifier": "com.visual-source.app",
  "build": {
    "beforeDevCommand": "bun run vite-dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run vite-build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Visual Source",
        "fullscreen": false,
        "height": 800,
        "width": 1200,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
